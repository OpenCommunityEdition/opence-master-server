package view

// The table's classes (a table scrolls sideways in its card on a narrow
// screen rather than the page).
const (
	TableWrap = "-mx-6 overflow-x-auto px-6"
	Table     = "w-full border-collapse text-sm"
	Th        = "border-b border-line px-3 py-2 text-left text-xs font-medium tracking-wide text-muted uppercase first:pl-0 last:pr-0"
	ThNum     = Th + " text-right"
	Td        = "border-b border-line px-3 py-2.5 align-top first:pl-0 last:pr-0"
	TdNum     = Td + " text-right tabular-nums"
	Tr        = "transition-colors hover:bg-fg/[0.03]"
)

// Document is the HTML around every page.
templ Document(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content="light dark"/>
			<title>{ title }</title>
			<link rel="stylesheet" href="/static/style.css"/>
		</head>
		<body class="min-h-screen">
			{ children... }
		</body>
	</html>
}

// Card is a panel of the page.
templ Card() {
	<section class="rounded-xl border border-line bg-surface p-6 shadow-sm">
		{ children... }
	</section>
}

// CardHeader is a card's title, and a line under it (none if empty).
templ CardHeader(title, description string) {
	<div class="mb-4">
		<h2>{ title }</h2>
		if description != "" {
			<p class="mt-1 text-sm text-muted">{ description }</p>
		}
	</div>
}

// Badge is a word in a coloured pill.
templ Badge(tone Tone, text string) {
	<span class={ ToneClass(tone) }>{ text }</span>
}

// StatusBadge is a status in its colour.
templ StatusBadge(status string) {
	@Badge(StatusTone(status), status)
}

// Alert is a notice (OK), a warning or an error (Bad), across the page.
templ Alert(tone Tone) {
	<div
		role={ alertRole(tone) }
		class={ "rounded-lg border px-4 py-3 text-sm",
			templ.KV("border-ok/40 bg-ok/10", tone == OK),
			templ.KV("border-warn/40 bg-warn/10", tone == Warn),
			templ.KV("border-bad/50 bg-bad/15", tone == Bad),
			templ.KV("border-accent/40 bg-accent/10", tone == Info || tone == Neutral) }
	>
		{ children... }
	</div>
}

// Fields is a list of names and values.
templ Fields() {
	<dl class="grid grid-cols-1 gap-x-8 gap-y-1 text-sm sm:grid-cols-[max-content_1fr] sm:gap-y-3">
		{ children... }
	</dl>
}

// Field is a name and its value, in Fields.
templ Field(name string) {
	<dt class="text-muted max-sm:mt-2">{ name }</dt>
	<dd class="min-w-0">
		{ children... }
	</dd>
}

// FormField is a form's input with its label and a hint (none if empty).
templ FormField(id, label, hint string) {
	<div class="space-y-1.5">
		<label for={ id } class="block text-sm font-medium">{ label }</label>
		{ children... }
		if hint != "" {
			<p class="text-xs text-muted">{ hint }</p>
		}
	</div>
}

// Hint is a line of help.
templ Hint() {
	<p class="text-xs text-muted">
		{ children... }
	</p>
}

// Empty is a card's or a table's "nothing here".
templ Empty(text string) {
	<p class="py-6 text-center text-sm text-muted">{ text }</p>
}

// CSRF is a form's CSRF token.
templ CSRF(token string) {
	<input type="hidden" name="csrf" value={ token }/>
}

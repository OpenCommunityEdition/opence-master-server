# The master's settings for compose.yaml (every option is in README.md).
MASTER_PUBLIC_URL=https://master1.example.org
# The name, the contact and the admin token are made by the first launch's
# setup: open the link in the log (docker compose logs master). Set here,
# they win.
#MASTER_NAME=OpenCE Master 1
#MASTER_CONTACT=admin@example.org
# 32 characters or more: openssl rand -hex 32
#MASTER_ADMIN_TOKEN=
# The Discord bot that takes the applications: set on the admin pages
# (Discord), or here, which then wins (README.md, "The Discord bot")
#MASTER_DISCORD_TOKEN=
#MASTER_DISCORD_GUILD=
#MASTER_DISCORD_INVITE=
# the log channel and the approver roles are chosen in Discord with the bot's
# /configure; these set them instead
#MASTER_DISCORD_CHANNEL=
#MASTER_DISCORD_APPROVER_ROLES=
# updates (README.md, "Updating"): notify (default: the admins update with a
# button), auto (install new releases at once) or off
#MASTER_UPDATES=notify
# a Discord webhook also told of new applications (optional)
MASTER_NOTIFY_WEBHOOK=
# peer masters: "<url> ed25519:<64 hex>", separated by commas
MASTER_PEERS=
# mail to the operators of the earlier web form's applications (optional;
# without it mails are written to the log)
MASTER_SMTP_ADDR=
# TLS to it: auto (implicit on port 465, else STARTTLS, required), starttls, tls
MASTER_SMTP_TLS=auto
MASTER_SMTP_USER=
MASTER_SMTP_PASSWORD=
MASTER_MAIL_FROM=
